# 640x480x8 setup copied from trident_mode.hwb; see its source references.
# Manufacturer: NEC LCD172VXM/192VXM manual p.20 (preset/sync).
# https://www.sharp-nec-displays.com/support/webdl/dl_service/data/display_j/manual/manu_LCD172_192VXM_No01.pdf
# Trident ProVidia 9682 datasheet unavailable; extended delivery is unverified.
# Sources: trident_driver-1.4.0.c:1028-1047,1064,2294,2313,2384,2525-2529
# trident_dac.c:256,572-576,631-658,673-678,781-810,871-907
# trident_pll.c:42-55,60-135; trident_regs.h:27-28
# vgaHW.c:845-872,1240-1286,1391-1468 (KGA_ENABLE_ON_ZERO).
# Run: hw run -o /tmp/tri_burst.log /test/hw/tri_burst.hwb
# Same mode/save/restore as trident_mode.hwb. One burst spans 0..0xFFF,
# including 0x80 and 0x800. Save/restore every touched byte with single accesses.
# PCIReg bits 1/2: xf86-video-trident trident_dac.c:715-721 (MIT/X11).
# Their individual read/write meanings are unknown; report observations only.
# Each trial prints CR39 before/after, all matching offsets and first 8 misses.
# CTRL+STOP or an access error stops execution; cleanup is the normal path only.
 device d = bdf 0:8.0
 window v = bar d 1
 window f = bar d 0
 mmiowrite8 v + 0x3CE 6
 mmioread8 v + 0x3CF -> gr6
 label setup
 call state_save
 # PC-98 PCI skips MMIO enable: driver 519-521;
 # INB/OUTB/OUTW, including configuration ports, use BAR1: regs 302-325.
 call pc98_init
 mmiowrite8 v + 0x3C4 0x0B
 mmioread8 v + 0x3C5 -> t
 mmiowrite8 v + 0x3D4 0xC0
 mmioread8 v + 0x3D5 -> ref
 let a = 0xE5
 let b = 0x1E
 if (ref & 0x80) == 0 goto pll_ready
 let a = 0xA4
 let b = 0x0E
 label pll_ready
 print "reference-select" ref
 print "PLL-a" a
 print "PLL-b" b
 mmiowrite8 v + 0x3D4 0x11
 mmioread8 v + 0x3D5 -> t
 mmiowrite8 v + 0x3D5 t & 0x7F
 call protect_on
 # Column 3: blanked standard VGA restore.
 mmiowrite8 v + 0x3C2 0xE3
 mmiowrite16 v + 0x3C4 0x01 | ((0x21) << 8)
 mmiowrite16 v + 0x3C4 0x02 | ((0x0F) << 8)
 mmiowrite16 v + 0x3C4 0x03 | ((0x00) << 8)
 mmiowrite16 v + 0x3C4 0x04 | ((0x0E) << 8)
 mmiowrite16 v + 0x3D4 0x11 | ((0x2C) << 8)
 mmiowrite16 v + 0x3D4 0x00 | ((0x5F) << 8)
 mmiowrite16 v + 0x3D4 0x01 | ((0x4F) << 8)
 mmiowrite16 v + 0x3D4 0x02 | ((0x4F) << 8)
 mmiowrite16 v + 0x3D4 0x03 | ((0x80) << 8)
 mmiowrite16 v + 0x3D4 0x04 | ((0x52) << 8)
 mmiowrite16 v + 0x3D4 0x05 | ((0x1E) << 8)
 mmiowrite16 v + 0x3D4 0x06 | ((0x0B) << 8)
 mmiowrite16 v + 0x3D4 0x07 | ((0x3E) << 8)
 mmiowrite16 v + 0x3D4 0x08 | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x09 | ((0x40) << 8)
 mmiowrite16 v + 0x3D4 0x0A | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x0B | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x0C | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x0D | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x0E | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x0F | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x10 | ((0xEA) << 8)
 mmiowrite16 v + 0x3D4 0x11 | ((0x2C) << 8)
 mmiowrite16 v + 0x3D4 0x12 | ((0xDF) << 8)
 mmiowrite16 v + 0x3D4 0x13 | ((0x50) << 8)
 mmiowrite16 v + 0x3D4 0x14 | ((0x00) << 8)
 mmiowrite16 v + 0x3D4 0x15 | ((0xDF) << 8)
 mmiowrite16 v + 0x3D4 0x16 | ((0x0B) << 8)
 mmiowrite16 v + 0x3D4 0x17 | ((0xC3) << 8)
 mmiowrite16 v + 0x3D4 0x18 | ((0xFF) << 8)
 mmiowrite16 v + 0x3CE 0x00 | ((0x00) << 8)
 mmiowrite16 v + 0x3CE 0x01 | ((0x00) << 8)
 mmiowrite16 v + 0x3CE 0x02 | ((0x00) << 8)
 mmiowrite16 v + 0x3CE 0x03 | ((0x00) << 8)
 mmiowrite16 v + 0x3CE 0x04 | ((0x00) << 8)
 mmiowrite16 v + 0x3CE 0x05 | ((0x40) << 8)
 if mode == 3 goto keep_gr6
 mmiowrite16 v + 0x3CE 0x06 | ((5) << 8)
 goto gr6_ready
 label keep_gr6
 mmiowrite16 v + 0x3CE 0x06 | ((gr6) << 8)
 label gr6_ready
 mmiowrite16 v + 0x3CE 0x07 | ((0x0F) << 8)
 mmiowrite16 v + 0x3CE 0x08 | ((0xFF) << 8)
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x00
 mmiowrite8 v + 0x3C0 0x00
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x01
 mmiowrite8 v + 0x3C0 0x01
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x02
 mmiowrite8 v + 0x3C0 0x02
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x03
 mmiowrite8 v + 0x3C0 0x03
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x04
 mmiowrite8 v + 0x3C0 0x04
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x05
 mmiowrite8 v + 0x3C0 0x05
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x06
 mmiowrite8 v + 0x3C0 0x06
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x07
 mmiowrite8 v + 0x3C0 0x07
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x08
 mmiowrite8 v + 0x3C0 0x08
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x09
 mmiowrite8 v + 0x3C0 0x09
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0A
 mmiowrite8 v + 0x3C0 0x0A
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0B
 mmiowrite8 v + 0x3C0 0x0B
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0C
 mmiowrite8 v + 0x3C0 0x0C
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0D
 mmiowrite8 v + 0x3C0 0x0D
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0E
 mmiowrite8 v + 0x3C0 0x0E
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x0F
 mmiowrite8 v + 0x3C0 0x0F
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x10
 mmiowrite8 v + 0x3C0 0x41
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x11
 mmiowrite8 v + 0x3C0 0x00
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x12
 mmiowrite8 v + 0x3C0 0x0F
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x13
 mmiowrite8 v + 0x3C0 0x00
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x14
 mmiowrite8 v + 0x3C0 0x00
 # Column 4: hidden command is separate from palette mask.
 mmiowrite8 v + 0x3C4 0x0B
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 0xC20E
 mmioread8 v + 0x3C8 -> t
 mmioread8 v + 0x3C6 -> t
 mmioread8 v + 0x3C6 -> t
 mmioread8 v + 0x3C6 -> t
 mmioread8 v + 0x3C6 -> t
 mmiowrite8 v + 0x3C6 0
 mmioread8 v + 0x3C8 -> t
 # Column 5: extended restore, zero-initialized CR3A/CR50.
 mmiowrite16 v + 0x3D4 0x1E | ((0x80) << 8)
 mmiowrite16 v + 0x3D4 0x21 | ((0x20) << 8)
 mmiowrite16 v + 0x3C4 0x0D | ((0x20) << 8)
 mmiowrite16 v + 0x3D4 0x50 | ((0) << 8)
 mmiowrite16 v + 0x3D4 0x27 | ((8) << 8)
 mmiowrite16 v + 0x3D4 0x2B | ((0) << 8)
 mmiowrite8 v + 0x3D4 0x29
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x29 | ((t & 0xCF) << 8)
 mmiowrite16 v + 0x3D4 0x36 | ((0x80) << 8)
 mmiowrite8 v + 0x3D4 0x2F
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x2F | ((t | 0x10) << 8)
 mmiowrite8 v + 0x3D4 0x2A
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x2A | ((t | 0x40) << 8)
 mmiowrite16 v + 0x3D4 0x3A | ((0) << 8)
 mmiowrite16 v + 0x3D4 0x38 | ((0) << 8)
 mmiowrite8 v + 0x3D4 0x39
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x39 | (((t & 0xF9) | 6) << 8)
 mmiowrite16 v + 0x3D4 0x55 | ((0x1F) << 8)
 mmiowrite8 v + 0x3CE 0x2F
 mmioread8 v + 0x3CF -> t
 mmiowrite16 v + 0x3CE 0x2F | ((t | 4) << 8)
 mmiowrite8 v + 0x3CE 0x0F
 mmioread8 v + 0x3CF -> t
 mmiowrite16 v + 0x3CE 0x0F | (((t & 0xF0) | 2) << 8)
 mmiowrite16 v + 0x3D4 0x13 | ((0x50) << 8)
 # Column 6: old PLL; MCLK was set by PC98 init, no SR18/19 changes.
 mmiowrite8 v + 0x43C8 a
 mmiowrite8 v + 0x43C9 b
 mmiowrite8 v + 0x3C2 0xEB
 mmiowrite16 v + 0x3C4 0xC20E
 call protect_off
 call enable
 pciread32 d 0x10 -> t
 print "BAR0" t
 mmiowrite8 v + 0x3D4 0x21
 mmioread8 v + 0x3D5 -> t
 print "CR21" t
 mmiowrite8 v + 0x3D4 0x39
 mmioread8 v + 0x3D5 -> t
 print "CR39" t
 dim original 1024
 let i = 0
 label backup_words
 mmioread32 f + (i << 2) -> original[i]
 let i = i + 1
 if i != 1024 goto backup_words
 mmiowrite8 v + 0x3D4 0x39
 mmioread8 v + 0x3D5 -> burstcr
 print "CR39-saved" burstcr
 let seed = 0x5A000000
 log "trial-a-original"
 let trialcr = burstcr
 call burst_trial
 log "trial-b-clear-bit1"
 let trialcr = burstcr & 0xFD
 call burst_trial
 log "trial-c-clear-bit2"
 let trialcr = burstcr & 0xFB
 call burst_trial
 log "trial-d-clear-both"
 let trialcr = burstcr & 0xF9
 call burst_trial
 mmiowrite16 v + 0x3D4 0x39 | (burstcr << 8)
 mmioread8 v + 0x3D5 -> t
 print "CR39-restored" t
 let i = 0
 label restore_words
 mmiowrite32 f + (i << 2) original[i]
 let i = i + 1
 if i != 1024 goto restore_words
 call disable
 call state_restore
 end

 label burst_trial
 print "CR39-requested" trialcr
 mmiowrite16 v + 0x3D4 0x39 | (trialcr << 8)
 mmioread8 v + 0x3D5 -> t
 print "CR39-before" t
 mmioblock32 f + 0 1024 0xA5000000
 print "B-seed" seed
 mmioblock32 f + 0 1024 seed inc
 let i = 0
 let bad = 0
 label compare_words
 let off = i << 2
 mmioread32 f + off -> got
 if got != (seed + i) goto word_mismatch
 print "match-offset" off
 goto word_next
 label word_mismatch
 let bad = bad + 1
 if ((bad-1) >> 3) != 0 goto word_next
 print "mismatch-offset" off
 print "expected" (seed + i)
 print "actual" got
 label word_next
 let i = i + 1
 if i != 1024 goto compare_words
 print "mismatch-count" bad
 mmiowrite8 v + 0x3D4 0x39
 mmioread8 v + 0x3D5 -> t
 print "CR39-after" t
 # Vary B so a previous successful trial cannot hide dropped stores.
 let seed = seed + 0x10000
 return

 label enable
 iowrite8 port 0x68 0x0E
 iowrite8 port 0x6A 0x07
 iowrite8 port 0x6A 0x8F
 iowrite8 port 0x6A 0x06
 call protect_on
 mmiowrite8 v + 0x3D4 0x23
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x23 | ((t & 0xDF) << 8)
 mmiowrite8 v + 0x3D4 0x29
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x29 | ((t | 4) << 8)
 let mask = 0xFF
 let bits = 6
 call dac
 let bits = 8
 call dac
 mmiowrite8 v + 0x3CE 0x23
 mmioread8 v + 0x3CF -> t
 mmiowrite16 v + 0x3CE 0x23 | ((t & 0xFC) << 8)
 let bits = 1
 call dac
 mmiowrite8 v + 0x3C4 1
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 1 | ((t & 0xEF) << 8)
 call protect_off
 iowrite8 port 0xFAC 2
 return
 label disable
 iowrite8 port 0xFAC 0
 call protect_on
 mmiowrite8 v + 0x3C4 1
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 1 | ((t | 0x10) << 8)
 let bits = 0
 let mask = 0xFE
 call dac
 mmiowrite8 v + 0x3CE 0x23
 mmioread8 v + 0x3CF -> t
 mmiowrite16 v + 0x3CE 0x23 | (((t & 0xFC) | 1) << 8)
 let mask = 0xFD
 call dac
 let mask = 0xCF
 call dac
 let mask = 0xF7
 call dac
 let mask = 0xFB
 call dac
 mmiowrite8 v + 0x3D4 0x29
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x29 | ((t & 0xFB) << 8)
 mmiowrite8 v + 0x3D4 0x23
 mmioread8 v + 0x3D5 -> t
 mmiowrite16 v + 0x3D4 0x23 | ((t | 0x20) << 8)
 call protect_off
 iowrite8 port 0x6A 0x07
 iowrite8 port 0x6A 0x8E
 iowrite8 port 0x6A 0x06
 iowrite8 port 0x68 0x0F
 return
 label dac
 mmiowrite8 v + 0x83C8 4
 mmioread8 v + 0x83C6 -> t
 mmiowrite8 v + 0x83C8 4
 mmiowrite8 v + 0x83C6 (t & mask) | bits
 return
 label protect_on
 mmiowrite8 v + 0x3C4 1
 mmioread8 v + 0x3C5 -> savedseq
 mmiowrite8 v + 0x3C4 0
 mmiowrite8 v + 0x3C5 1
 mmiowrite8 v + 0x3C4 1
 mmiowrite8 v + 0x3C5 savedseq | 0x20
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0
 return
 label protect_off
 mmiowrite8 v + 0x3C4 1
 mmioread8 v + 0x3C5 -> savedseq
 mmiowrite8 v + 0x3C4 1
 mmiowrite8 v + 0x3C5 savedseq & 0xDF
 mmiowrite8 v + 0x3C4 0
 mmiowrite8 v + 0x3C5 3
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x20
 return

 # PC98TRIDENT96xxInit: driver 616-692, vgaHW.c 1795-1806.
 label pc98_init
 mmioread8 v + 0x3CC -> t
 mmiowrite8 v + 0x3C2 t | 0xC3
 mmiowrite8 v + 0x3C4 0x0B
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 0x0B | (t << 8)
 mmiowrite8 v + 0x3C4 0x0E
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 0x0E | ((t | 0x20) << 8)
 mmiowrite8 v + 0x3C4 0x0C
 mmioread8 v + 0x3C5 -> flip
 let flip = flip & 0x10
 print "PC98-SR0C-bit4" flip
 if flip == 0 goto pc98_config_alt
 mmiowrite8 v + 0x3C4 0x0E
 mmiowrite8 v + 0x94 0
 mmiowrite8 v + 0x102 1
 mmiowrite8 v + 0x94 0x20
 mmioread8 v + 0x3C3 -> t
 mmiowrite8 v + 0x3C3 t | 1
 goto pc98_config_done
 label pc98_config_alt
 mmiowrite8 v + 0x3C4 0x0E
 mmiowrite8 v + 0x46E8 0x10
 mmiowrite8 v + 0x102 1
 mmiowrite8 v + 0x46E8 8
 label pc98_config_done
 mmioread8 v + 0x3DA -> flip
 mmiowrite8 v + 0x3C0 0x10
 mmiowrite8 v + 0x3C0 0x41
 mmiowrite8 v + 0x3D4 0x11
 mmioread8 v + 0x3D5 -> t
 mmiowrite8 v + 0x3D4 0x11
 mmiowrite8 v + 0x3D5 t & 0x7F
 mmiowrite8 v + 0x3C4 0x0B
 mmioread8 v + 0x3C5 -> t
 mmiowrite8 v + 0x3C4 0x0E
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 0x0E | ((t | 0x80) << 8)
 mmiowrite16 v + 0x3D4 0x3820
 mmiowrite16 v + 0x3D4 0x2020
 mmiowrite16 v + 0x3D4 0x0E30
 mmiowrite16 v + 0x3D4 0x0031
 mmiowrite16 v + 0x3D4 0x0032
 mmiowrite16 v + 0x3D4 0x213B
 mmiowrite8 v + 0x43C6 0xAF
 mmiowrite8 v + 0x43C7 0
 mmiowrite8 v + 0x3C4 0x0B
 mmioread8 v + 0x3C5 -> t
 mmiowrite8 v + 0x3C4 0x0E
 mmioread8 v + 0x3C5 -> t
 mmiowrite16 v + 0x3C4 0x0E | ((t & 0x7F) << 8)
 mmiowrite8 v + 0x3D4 0x11
 mmioread8 v + 0x3D5 -> t
 mmiowrite8 v + 0x3D4 0x11
 mmiowrite8 v + 0x3D5 t | 0x80
 return

 # TRIDENTSave/Restore: driver 1084-1136; VGA 1016-1166,845-892.
 # Ra266 is not the boot VGA primary: PCI Command=0002, PC-98 display.
 # Primary && text is false (PM decision); no font/text planes are touched.
 # 9682: progClock=true, non-Cyber, non-3D, NewClockCode=false, TVChipset=0.
 # MCLK option defaults to 0 (driver 3046-3051); Init 80MHz is independent.
 # save[0..767] DAC; 768 misc; 769..793 CR; 794..814 AR;
 # 815..823 GR; 824..827 SR1..4; 828..851 Trident.
 label state_save
 dim save 852
 let cb = 0x3D4
 # vgaHWGetIOBase precedes ScreenInit/Save (driver:1970).
 mmioread8 v + 0x3CC -> t
 if (t & 1) != 0 goto palette_base
 let cb = 0x3B4
 label palette_base
 # NEED_SAVED_CMAP: first invocation, VGA 1051-1140.
 mmiowrite8 v + 0x3C6 0xFF
 mmiowrite8 v + 0x3C7 0
 let i = 0
 label save_rgb6
 mmioread8 v + 0x3C9 -> save[i]
 let i = i + 1
 if i != 6 goto save_rgb6
 mmiowrite8 v + 0x3C8 1
 let i = 3
 label test_rgb_write
 mmiowrite8 v + 0x3C9 (save[i] ^ 0x3F) & 0x3F
 let i = i + 1
 if i != 6 goto test_rgb_write
 mmiowrite8 v + 0x3C7 1
 let badmap = 0
 let i = 3
 label test_rgb_read
 mmioread8 v + 0x3C9 -> t
 if t == ((save[i] ^ 0x3F) & 0x3F) goto test_rgb_match
 let badmap = 1
 label test_rgb_match
 let i = i + 1
 if i != 6 goto test_rgb_read
 mmiowrite8 v + 0x3C8 1
 let i = 3
 label undo_rgb_test
 mmiowrite8 v + 0x3C9 save[i]
 let i = i + 1
 if i != 6 goto undo_rgb_test
 if badmap != 0 goto default_rgb
 mmiowrite8 v + 0x3C7 2
 let i = 6
 label save_rgb
