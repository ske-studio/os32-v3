 mmioread8 v + (cb+6) -> t
 let i = i + 1
 if i != 768 goto restore_rgb
 mmioread8 v + (cb+6) -> t
 mmiowrite8 v + 0x3C0 0x20
 # vgaHWProtect(FALSE) now uses the saved VGA IOBase.
 mmiowrite8 v + 0x3C4 1
 mmioread8 v + 0x3C5 -> savedseq
 mmiowrite8 v + 0x3C4 1
 mmiowrite8 v + 0x3C5 savedseq & 0xDF
