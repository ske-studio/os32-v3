 let savemclk = 0
 if savemclk == 0 goto saved_mclk
 mmioread8 v + 0x43C6 -> save[849]
 mmioread8 v + 0x43C7 -> save[850]
 label saved_mclk
 mmiowrite8 v + 0x3C4 0x0D
 mmioread8 v + (0x3C4+1) -> save[851]
 mmiowrite16 v + 0x3C4 0x0E | ((save[828]) << 8)
