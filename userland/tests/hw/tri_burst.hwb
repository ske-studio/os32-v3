 # VGA mode V:845-873.
 mmiowrite8 v + 0x3C2 save[768]
 let i = 1
 label restore_sr
 mmiowrite16 v + 0x3C4 i | ((save[823+i]) << 8)
 let i = i + 1
 if i != 5 goto restore_sr
 mmiowrite16 v + cb 0x11 | ((save[786] & 0x7F) << 8)
 let i = 0
 label restore_cr
 mmiowrite16 v + cb i | ((save[769+i]) << 8)
 let i = i + 1
 if i != 25 goto restore_cr
 let i = 0
 label restore_gr
 mmiowrite16 v + 0x3CE i | ((save[815+i]) << 8)
 let i = i + 1
 if i != 9 goto restore_gr
 mmioread8 v + (cb+6) -> t
 mmiowrite8 v + 0x3C0 0
 let i = 0
 label restore_ar
 mmioread8 v + (cb+6) -> t
 mmiowrite8 v + 0x3C0 i
