# Apple GMAC, UniNorth 106b:0021. OpenBSD sys/dev/ic/gemreg.h defines
# GEM_MAC_TX_CONFIG and GEM_MAC_RX_CONFIG; platform/powermac/lan_gem_io.c
# rd() reads these as LE32. See pm_gmac_early_quiesce in pci_config.c.
device d = id 106b:0021
window regs = bar d 0
mmioread32 regs + 0x6030 -> v
print "TX_CONFIG" v
mmioread32 regs + 0x6034 -> v
print "RX_CONFIG" v
end
