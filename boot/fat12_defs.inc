; Named constants; C mirrors are checked by test_boot_named_constants.py.
%ifndef OS32_BOOT_FAT12_DEFS_INC
%define OS32_BOOT_FAT12_DEFS_INC
; FAT12 on-disk directory and cluster encoding.
FAT12_NAME_BYTES EQU 11
FAT12_DIRENT_BYTES EQU 32
FAT12_DIRENT_DELETED EQU 0xE5
FAT12_DIRENT_CLUSTER_OFF EQU 0x1A
FAT12_FIRST_CLUSTER EQU 2
FAT12_EOC_MIN EQU 0xFF8
FAT12_CLUSTER_MASK EQU 0xFFF
FAT12_ODD_SHIFT EQU 4
%endif
