; Named constants; checked by test_boot_named_constants.py.
%ifndef OS32_BOOT_VK32_DEFS_INC
%define OS32_BOOT_VK32_DEFS_INC
; VK32 v2 wire format (boot/boot_defs.h and tools/mkvmkernel.py).
VK32_COMMON_SIZE EQU 16
VK32_ENTRY_SIZE EQU 16
VK32_ENTRY_SHIFT EQU 4 ; log2(VK32_ENTRY_SIZE)
VK32_WORD_BYTES EQU 4
VK32_TRAILER_BYTES EQU 2 * VK32_WORD_BYTES
VK32_OFF_HEADER_SIZE EQU 4
VK32_OFF_VERSION EQU 8
VK32_OFF_ENTRY_COUNT EQU 12
VK32_ENTRY_OFF_RAW_SIZE EQU 4
VK32_ENTRY_OFF_DATA_OFFSET EQU 8
VK32_ENTRY_OFF_COMPRESSED_SIZE EQU 12
%endif
