      "name": "dev_blk_read",
      "out": "target",
      "ret": "int",
      "args": ["const char *dev_name", "u32 lba", "int count", "void *buf"],
      "body": "{ Device *d = dev_find(dev_name); if (!d) return -1; if (count < 0) return -1; if (count > 0 && buf && d->sect_size > 0) { if ((u32)count > 0xFFFFFFFFu / (u32)d->sect_size) return -1; if (!ring3_user_ranges_writable((u32)buf, (u32)count * (u32)d->sect_size, 0, 0)) ring3_fault_kill(); } return dev_blk_read_lba(d, lba, count, buf); }"
    },
    {
      "name": "dev_blk_write",
      "ret": "int",
      "args": ["const char *dev_name", "u32 lba", "int count", "const void *buf"],
      "body": "{ Device *d = dev_find(dev_name); if (!d) return -1; return dev_blk_write_lba(d, lba, count, buf); }"
