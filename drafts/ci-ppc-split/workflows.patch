           if-no-files-found: error
+
+  ppc-compile:
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event_name == 'workflow_dispatch' && inputs.ref || 'main' }}
+      - name: PPC build dependencies
+        run: |
+          sudo apt-get update
